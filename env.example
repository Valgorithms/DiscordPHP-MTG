# DiscordPHP-MTG configuration. Copy to `.env` in the project directory and
# fill in what you use:   cp env.example .env
#
# Only placeholders here; never commit a real token. A variable already set in
# the environment wins over `.env`. Comments must be on their own line: the
# loaders read everything after `=` as the value. Empty values use the default.

# --- Discord (bot.php) ---------------------------------------------------------

# Discord bot token. Required for bot.php.
TOKEN=
# Discord user id that is DMed unhandled errors. Optional; defaults to the maintainer.
technician_id=
# Set to 1 to log errors without DMing them. Optional.
TESTING=
# debug, info, notice, warning or error. Optional; defaults to debug.
LOG_LEVEL=
# Set to 1 to answer [[Card Name]] in any message the bot can read. Needs the
# privileged Message Content intent turned on for the application in the
# Developer Portal first, or Discord refuses the connection. Optional; off.
MTG_INLINE_LOOKUPS=

# --- MTGJSON -------------------------------------------------------------------

# Where MTGJSON's AllPrintings SQLite build is kept (~700 MB; ~250 MB download on
# first run, refreshed daily). Today's prices are kept beside it. Optional;
# defaults to var/mtgjson/AllPrintings.sqlite.
MTGJSON_DATABASE=
# Set to 0 to go without card prices (a ~5 MB download a day). Optional; on.
MTG_PRICES=

# --- Tests (phpunit) -----------------------------------------------------------

# Bot token the live tests connect with.
MTG_TOKEN=
# Channel id the live tests may use.
TEST_CHANNEL=
